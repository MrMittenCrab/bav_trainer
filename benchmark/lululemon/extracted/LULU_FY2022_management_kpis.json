        "section": "Item 7 — Comparable Store Sales and Total Comparable Sales",
        "page_reference": "Form 10-K p. 31"
      }
    },
    {
      "definition_id": "sales_per_square_foot_fy2022",
      "metric_id": "sales_per_square_foot",
      "reported_label": "Sales per square foot",
      "definition": "Total net revenue from all company-operated stores divided by average store square footage during the year. The 53rd week, when applicable, is excluded. Square footage includes retail-related space, storage, and store administrative space.",
