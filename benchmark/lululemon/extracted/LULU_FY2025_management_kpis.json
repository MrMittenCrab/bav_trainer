  "kpi_definitions": [
    {
      "definition_id": "comparable_sales_fy2025",
      "metric_id": "comparable_sales_growth",
      "reported_label": "Comparable sales",
      "definition": "Comparable company-operated store and all e-commerce net revenue. Comparable company-operated stores must have been open, or open after significant expansion, for at least 12 full fiscal months. Excludes new/expanded stores under 12 months, temporarily relocated/closed stores, closed stores, and channels other than company-operated stores and e-commerce. Because FY2024 had 53 weeks, the prior-year comparison is shifted by one week to compare similar calendar weeks. Mexico stores acquired in September 2024 became comparable beginning in October 2025 after 12 months.",
      "source": {
        "section": "Item 7 — Comparable Sales and Sales Per Square Foot",
        "page_reference": "Form 10-K p. 34"
      }
    },
    {
      "definition_id": "sales_per_square_foot_fy2025",
      "metric_id": "sales_per_square_foot",
      "reported_label": "Sales per square foot",
      "definition": "Total net revenue from all company-operated stores divided by average ending square footage during the year; 53rd-week revenue is excluded when applicable.",
      "source": {
        "section": "Item 7 — Sales Per Square Foot",
        "page_reference": "Form 10-K p. 34"
      }
    }
  ],
