        "section": "Item 7 — Comparable Sales and Sales Per Square Foot",
        "page_reference": "Form 10-K pp. 33–34"
      }
    },
    {
      "definition_id": "sales_per_square_foot_fy2024",
      "metric_id": "sales_per_square_foot",
      "reported_label": "Sales per square foot",
      "definition": "Total net revenue from all company-operated stores divided by average ending square footage during the year. The 53rd week is excluded.",
